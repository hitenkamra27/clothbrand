# Copy this file to .env and fill in real values. .env is gitignored —
# it should never be committed or uploaded anywhere public.

# Admin username for the /admin login page.
ADMIN_USERNAME=admin

# Bcrypt hash of your admin password — NOT the plain password itself.
# Generate one with:   npm run hash-password -- "your-new-password"
# (demo value below is the hash of "ChangeMe123!" — change it before going live)
ADMIN_PASSWORD_HASH=$2a$12$G9qErUdIwEF7gs4eQrNdMeDqmX9iuH.4QNTf2PgHD8DQOCVymbbo6

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Port the server listens on. Most hosts (Render/Railway) set this for you.
PORT=3000

# Set to "production" when deployed behind HTTPS so cookies are marked secure.
NODE_ENV=development

# --- Supabase (required) ---
# The site's product/customer/order/etc. data lives in Supabase (Postgres),
# connected to directly (no manual SQL Editor step needed — the app creates
# its own table automatically on first boot).
# 1. Go to https://supabase.com and create a free project (pick a database
#    password when prompted — you'll need it below).
# 2. On your project's dashboard, click the green "Connect" button (top of
#    page) → "Transaction pooler" tab → copy the connection string shown.
# 3. Paste it below, replacing [YOUR-PASSWORD] with the real database
#    password from step 1.
# 4. Run:  npm run migrate-to-supabase   (one time, to import your existing
#    data/*.json files into Supabase — safe to re-run).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Shiprocket Shipping (recommended — fully functional) ---
# Powers real order booking + tracking via Shiprocket's public API
# (src/services/shiprocket.js). Leave blank to keep fulfilling orders
# manually; once set, marking an order "processing" in /admin automatically
# books it with Shiprocket.
#   1. Sign up at https://www.shiprocket.in
#   2. Add a Pickup Location under Settings → Pickup Addresses and copy its
#      exact name into SHIPROCKET_PICKUP_LOCATION below.
#   3. Put your Shiprocket account email/password below (this is the same
#      login you use on shiprocket.in — not a separate API key).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=

# --- Shiprocket Checkout / Payments (optional) ---
# Leave blank to keep the site running on the built-in Cash-on-Delivery
# checkout. This is Shiprocket's one-click checkout + payment gateway
# product (the direct replacement for what GoKwik was wired up for here).
# For a custom/non-Shopify site like this one it requires merchant
# onboarding to get the exact snippet:
#   1. Sign up at https://checkout.shiprocket.in and complete KYC.
#   2. For custom-site/API integration, contact Shiprocket's integration
#      team via your merchant dashboard for the channel ID + JS snippet.
#   3. Paste the channel ID they give you below.
#   4. Restart the server — the "Checkout with Shiprocket" button on the
#      site activates automatically once this is set (see public/js/shiprocket.js).
SHIPROCKET_CHECKOUT_ID=
SHIPROCKET_ENV=sandbox

# --- Google Sign-In (customer accounts) ---
# Powers the "Continue with Google" button on Sign In / Create Account.
# 1. Go to console.cloud.google.com → APIs & Services → Credentials →
#    "Create Credentials" → OAuth client ID → Web application.
# 2. Under "Authorized JavaScript origins" add your site's URL
#    (e.g. http://localhost:3000 for local dev, https://yourdomain.com in prod).
# 3. Paste the generated Client ID below and restart the server.
# Leave blank to keep Google Sign-In hidden (the storefront falls back to
# email + password accounts automatically when this is empty).
GOOGLE_CLIENT_ID=

# --- Mobile OTP Verification (Account Settings) ---
# Powers "Verify Mobile Number" in a customer's Account Settings.
# Until these are set, OTP codes are logged to the server console (and sent
# back in the API response outside production) so you can test the whole
# flow before signing up with a real SMS provider.
# To go live with MSG91 (a common choice for Indian OTP SMS):
#   1. Sign up at https://msg91.com and create an OTP template.
#   2. Paste your Auth Key and Template ID below.
#   3. Restart the server — see sendOtpSms() in src/routes/customers.js if
#      you'd rather use a different provider (Twilio, Fast2SMS, etc.).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --- Password Reset Emails (Forgot Password) ---
# Powers the "Reset it" link on Sign In. Until SMTP_HOST is set, reset
# links are logged to the server console (and returned in the API
# response outside production) so you can test the whole flow without a
# live email account.
# Works with ANY SMTP provider — Gmail (with an App Password, not your
# normal password), SendGrid, Amazon SES, Brevo, Resend's SMTP mode, etc.
#   1. Get SMTP host/port/username/password from your provider.
#   2. Fill them in below. SMTP_FROM is the "from" address shown to
#      customers — falls back to SMTP_USER if left blank.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# The public URL of your site, used to build links in emails (e.g. the
# password reset link). Leave blank in local dev — it's inferred from the
# request automatically. Set this explicitly once deployed
# (e.g. https://yourdomain.com), so emails always link to the right place
# even if requests come in through a proxy/load balancer.
SITE_URL=
